{
  "name": "@qq304379685/dsh-zentao-panel",
  "version": "0.2.0",
  "description": "ZenTao panel for the DeepSeek Harness Web UI: bugs, my work, tasks and stories, plus zentao_* tools for the assistant.",
  "type": "module",
  "license": "MIT",
  "author": "qq304379685",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "zentao",
    "bug-tracker",
    "project-management"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qq304379685/dsh-zentao-dashboard-x.git"
  },
  "homepage": "https://github.com/qq304379685/dsh-zentao-dashboard-x#readme",
  "bugs": {
    "url": "https://github.com/qq304379685/dsh-zentao-dashboard-x/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  }
}